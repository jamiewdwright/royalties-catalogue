# Data source configuration
# Application now defaults to Supabase - only set this to 'mock' if you want to use local JSON files
# VITE_DATA_SOURCE=mock

# Supabase configuration (required for database functionality)
# Get these values from your Supabase project dashboard > Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service role key for admin operations (if needed in future)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key